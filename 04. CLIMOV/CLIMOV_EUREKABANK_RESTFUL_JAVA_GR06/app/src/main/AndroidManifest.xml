<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: el servidor es http (sin TLS), igual que los otros clientes -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/hud"
        android:theme="@style/Hud"
        android:usesCleartextTraffic="true">

        <activity android:name=".LoginActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".OperacionesActivity" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
